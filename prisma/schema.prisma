generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String        @unique
  passwordHash String
  role         Role          @default(PATIENT)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Specialization {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  doctors     Doctor[]
}

model Doctor {
  id               Int             @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String          @unique
  phone            String?
  specialization   Specialization  @relation(fields: [specializationId], references: [id])
  specializationId Int
  appointments     Appointment[]
  symptoms         DoctorSymptom[]
}

model Appointment {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  doctorId        Int
  appointmentDate DateTime
  status          Status   @default(PENDING)
  notes           String?
}

model Symptom {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  doctors     DoctorSymptom[]
}

model DoctorSymptom {
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  doctorId  Int
  symptom   Symptom @relation(fields: [symptomId], references: [id])
  symptomId Int

  @@id([doctorId, symptomId])
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
}
